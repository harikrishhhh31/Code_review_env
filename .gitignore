# =============================================================================
# .gitignore - Files to exclude from version control
# =============================================================================
#
# This file tells Git which files to IGNORE (not track).
# Why? Some files shouldn't be in the repository:
# - Build artifacts (generated files)
# - Virtual environments (too large)
# - API keys/secrets (security risk)
# - IDE settings (personal preference)
# - OS files (garbage)
#
# =============================================================================

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.c
*.o
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# celery beat schedule file
celerybeat-schedule

# SageMath parsed files
*.sage.py

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/

# -----------------------------------------------------------------------------
# IDEs
# -----------------------------------------------------------------------------

# VS Code
.vscode/
*.code-workspace

# JetBrains IDEs
.idea/
*.iml
out/

# Eclipse
.settings/
.project
.classpath

# Sublime Text
*.tmp
*.bak

# Atom
.atom/
.gedit/

# -----------------------------------------------------------------------------
# Operating System
# -----------------------------------------------------------------------------

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Icon must end with two \r
Icon
Icon?
.DS_Store?

# Thumbnails
._*

# Files that might appear on external disk
.Spotlight-V100
.Trashes

# Linux
*~

# KDE directory preferences
.directory

# -----------------------------------------------------------------------------
# OpenEnv Specific
# -----------------------------------------------------------------------------

# Environment state (generated at runtime)
*.session
*.lock

# Credentials and secrets
credentials.json
secrets.json
*.pem
*.key

# HuggingFace cache
.cache/
.huggingface/

# Docker
.dockerignore

# -----------------------------------------------------------------------------
# Dependencies
# -----------------------------------------------------------------------------

# pip
pip-log.txt

# UV
.uv/
uv.lock

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------

*.log
logs/
